# Firebase Configuration
# Get these from your Firebase project settings
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# WebAuthn Configuration
RP_NAME=Fund My Meal
RP_ID=localhost  # Will be overridden by Azure with your Container App domain

# Frontend Origin (used for CORS)
ORIGIN=http://localhost:3000  # Will be overridden by Azure with your Container App URL

# Environment
NODE_ENV=development
PORT=8080
